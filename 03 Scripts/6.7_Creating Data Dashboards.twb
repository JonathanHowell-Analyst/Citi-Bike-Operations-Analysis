    <window class='dashboard' name='Elbow Curve'>
      <viewpoints />
      <active id='-1' />
      <simple-id uuid='{D4192B1D-2BBE-45FE-96B9-94A7E96ED3CF}' />
    </window>
    <window class='worksheet' name='Behavioral Cluster Profiles'>
      <cards>
        <edge name='left'>
          <strip size='160'>
            <card type='pages' />
            <card type='filters' />
            <card type='marks' />
          </strip>
        </edge>
        <edge name='top'>
          <strip size='2147483647'>
